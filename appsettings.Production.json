{
  // Cấu hình dùng khi chạy thật (ASPNETCORE_ENVIRONMENT=Production).
  //
  // QUAN TRỌNG: không lưu chuỗi kết nối và khoá bí mật trong file này.
  // Hãy đặt bằng biến môi trường trên máy chủ, ví dụ:
  //   ConnectionStrings__DefaultConnection = Server=...;Database=WebBanHangDb;User Id=...;Password=...;TrustServerCertificate=True
  //   VnPay__TmnCode                        = mã terminal VNPay
  //   VnPay__HashSecret                     = khoá bí mật VNPay
  //   BankTransfer__BankBin                 = 970436
  //   BankTransfer__AccountNumber           = số tài khoản nhận tiền
//   Email__UserName                        = địa chỉ Gmail gửi đi
//   Email__Password                        = Gmail App Password (không phải mật khẩu đăng nhập)
  // Khi triển khai trên IIS, có thể đặt trong web.config mục <environmentVariables>.
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // Trên IIS / Windows Service có thể bật lại để ghi log sự cố vào Windows Event Log.
  "DetailedErrors": false,
  "AllowedHosts": "*"
}
