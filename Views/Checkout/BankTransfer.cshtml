@model BankTransferViewModel

@{
    ViewData["Title"] = "Chuyển khoản ngân hàng";
    var order = Model.Order;
}

<div class="container my-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">🏦 Chuyển khoản ngân hàng</h2>
        <p class="text-muted mb-1">Đơn hàng <strong>@order.OrderCode</strong> đã được ghi nhận.</p>
        <p class="fs-4 mb-0">Số tiền cần chuyển: <span class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</span></p>
    </div>

    <div class="row g-4 justify-content-center">
        @if (Model.QrAvailable)
        {
            <div class="col-md-5 text-center">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <img src="@Model.QrImageUrl" alt="Mã VietQR thanh toán đơn @order.OrderCode"
                             class="img-fluid border rounded" style="max-width: 320px;" />
                        <p class="text-muted small mt-2 mb-0">Quét mã bằng ứng dụng ngân hàng để điền sẵn số tiền và nội dung.</p>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Thông tin chuyển khoản</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Ngân hàng</span><strong>@Model.BankName</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Số tài khoản</span><strong>@Model.AccountNumber</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Chủ tài khoản</span><strong>@Model.AccountName</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Số tiền</span><strong class="text-danger">@order.TotalAmount.ToString("N0") đ</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Nội dung</span><strong>@Model.TransferContent</strong>
                    </li>
                </ul>
                <div class="card-body">
                    @if (!Model.QrAvailable)
                    {
                        <div class="alert alert-warning mb-3" role="alert">
                            Cửa hàng chưa cấu hình tài khoản ngân hàng để hiện mã QR.
                            Vui lòng liên hệ cửa hàng để được hướng dẫn thanh toán.
                        </div>
                    }
                    <p class="text-muted small mb-3">
                        ⚠️ Vui lòng ghi <strong>đúng nội dung</strong> là mã đơn hàng để cửa hàng đối chiếu nhanh.
                        Đơn hàng sẽ được xác nhận sau khi cửa hàng nhận được tiền.
                    </p>
                    <a asp-action="Success" asp-route-id="@order.Id" class="btn btn-primary w-100">Xem lại đơn hàng</a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">← Tiếp tục mua sắm</a>
                </div>
            </div>
        </div>
    </div>
</div>
