@model CheckoutViewModel
@inject WebBanHang.Services.VnPayService VnPay

@{
    ViewData["Title"] = "Đặt hàng";
}

<div class="container my-4">
    <h2 class="fw-bold border-bottom pb-2 mb-4">🧾 Thông tin đặt hàng</h2>

    <form asp-action="PlaceOrder" method="post">
        <div class="row g-4">
            <div class="col-lg-7">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="0912345678" inputmode="tel" maxlength="15" />
                        <div class="form-text">SĐT di động VN 10 số (Viettel, Vinaphone, Mobifone...)</div>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tỉnh / Thành phố</label>
                        <select id="vnProvince" class="form-select" required></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phường / Xã</label>
                        <select id="vnWard" class="form-select" required></select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Số nhà, tên đường</label>
                        <input id="vnStreet" class="form-control" placeholder="Số nhà, tên đường..." required />
                        <input asp-for="ShippingAddress" type="hidden" id="ShippingAddress" />
                        <div class="form-text">Bắt buộc nhập số nhà/đường. Chọn Tỉnh/TP → Phường/Xã.</div>
                        <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Ghi chú <span class="text-muted fw-normal">(không bắt buộc)</span></label>
                        <textarea name="Note" id="Note" class="form-control" rows="2" placeholder="Không bắt buộc" data-val="false"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="PaymentMethod" class="form-label"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="@((int)WebBanHang.Models.PaymentMethod.Cod)">Thanh toán khi nhận hàng (COD)</option>
                            <option value="@((int)WebBanHang.Models.PaymentMethod.BankTransfer)">Chuyển khoản ngân hàng (VietQR)</option>
                            @if (VnPay.IsConfigured)
                            {
                                <option value="@((int)WebBanHang.Models.PaymentMethod.VnPay)">Thanh toán online qua VNPay</option>
                            }
                        </select>
                        <div class="form-text">
                            @if (VnPay.IsConfigured)
                            {
                                <span>Thanh toán online qua VNPay sử dụng tài khoản sandbox đã cấu hình.</span>
                            }
                            else
                            {
                                <span>Thanh toán online VNPay/MoMo chưa được cấu hình nên tạm ẩn.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header fw-bold">Đơn hàng của bạn</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.ProductName <span class="text-muted">× @item.Quantity</span></span>
                                <span>@item.TotalPrice.ToString("N0") đ</span>
                            </li>
                        }
                        <li class="list-group-item d-flex justify-content-between fw-bold">
                            <span>Tổng cộng</span>
                            <span class="text-danger">@Model.TotalAmount.ToString("N0") đ</span>
                        </li>
                    </ul>
                    <div class="card-body d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Đặt hàng</button>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">← Về giỏ hàng</a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/vietnam-address.js" asp-append-version="true"></script>
    <script>
        initVnAddress({
            province: '#vnProvince',
            ward: '#vnWard',
            street: '#vnStreet',
            hidden: '#ShippingAddress'
        });
    </script>
}
