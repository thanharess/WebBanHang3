<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebBanHang</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebBanHang.styles.css" asp-append-version="true" />
</head>
<body>
    <form style="display:none">@Html.AntiForgeryToken()</form>
    <header class="site-header">
        <div class="shipping-bar"><span>FREESHIP ĐƠN TỪ 500.000đ</span><span class="shipping-bar-divider">•</span><span>ĐỔI TRẢ DỄ DÀNG TRONG 30 NGÀY</span></div>
        <nav class="navbar shop-header navbar-expand-xl navbar-dark">
            <div class="container header-inner">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">CT</span><span>CH&amp;T GOLF <small>EST. 2026</small></span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        @await Component.InvokeAsync("CategoryMenu")
                        <li class="nav-item dropdown gender-menu">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Nam</a>
                            <div class="dropdown-menu category-mega gender-mega">
                                <div class="category-mega-header">
                                    <a asp-controller="Products" asp-action="Index" asp-route-q="nam" class="category-mega-all">Tất cả đồ nam →</a>
                                </div>
                                <div class="category-mega-grid gender-mega-grid">
                                    <a class="category-mega-item" asp-controller="Products" asp-action="Index" asp-route-q="áo nam"><span class="category-mega-img-wrap category-mega-icon">👕</span><span class="category-mega-name">Áo golf nam</span></a>
                                    <a class="category-mega-item" asp-controller="Products" asp-action="Index" asp-route-q="quần nam"><span class="category-mega-img-wrap category-mega-icon">👖</span><span class="category-mega-name">Quần golf nam</span></a>
                                    <a class="category-mega-item" asp-controller="Products" asp-action="Index" asp-route-q="giày nam"><span class="category-mega-img-wrap category-mega-icon">👟</span><span class="category-mega-name">Giày golf nam</span></a>
                                    <a class="category-mega-item" asp-controller="Products" asp-action="Index" asp-route-q="nam"><span class="category-mega-img-wrap category-mega-icon">✨</span><span class="category-mega-name">Sản phẩm mới</span></a>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown gender-menu">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Nữ</a>
                            <div class="dropdown-menu category-mega gender-mega">
                                <div class="category-mega-header">
                                    <a asp-controller="Products" asp-action="Index" asp-route-q="nữ" class="category-mega-all">Tất cả đồ nữ →</a>
                                </div>
                                <div class="category-mega-grid gender-mega-grid">
                                    <a class="category-mega-item" asp-controller="Products" asp-action="Index" asp-route-q="áo nữ"><span class="category-mega-img-wrap category-mega-icon">👚</span><span class="category-mega-name">Áo golf nữ</span></a>
                                    <a class="category-mega-item" asp-controller="Products" asp-action="Index" asp-route-q="quần nữ"><span class="category-mega-img-wrap category-mega-icon">👗</span><span class="category-mega-name">Quần golf nữ</span></a>
                                    <a class="category-mega-item" asp-controller="Products" asp-action="Index" asp-route-q="giày nữ"><span class="category-mega-img-wrap category-mega-icon">👟</span><span class="category-mega-name">Giày golf nữ</span></a>
                                    <a class="category-mega-item" asp-controller="Products" asp-action="Index" asp-route-q="nữ"><span class="category-mega-img-wrap category-mega-icon">✨</span><span class="category-mega-name">Sản phẩm mới</span></a>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Tất cả sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="Index">Đơn hàng</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="Track">Tra cứu đơn</a>
                            </li>
                        }
                    </ul>

                    <form class="d-flex me-sm-3 my-2 my-sm-0" asp-controller="Products" asp-action="Index" method="get" role="search">
                        <input class="form-control form-control-sm me-2" type="search" name="q" placeholder="Tìm kiếm sản phẩm..." aria-label="Tìm kiếm sản phẩm" />
                        <button class="btn btn-sm btn-light" type="submit" aria-label="Tìm kiếm">⌕</button>
                    </form>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link cart-trigger dropdown-toggle"
                               asp-controller="Cart" asp-action="Index"
                               id="miniCartDropdown" role="button" data-bs-toggle="dropdown"
                               data-bs-auto-close="outside" aria-expanded="false">

                               🛒 Giỏ hàng <span class="cart-count">@CartService.GetItemCount()</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end mini-cart p-0" aria-labelledby="miniCartDropdown">
                                <div class="mini-cart-title">Giỏ hàng của bạn</div>
                                @{ var miniCart = CartService.GetCart(); }
                                @if (miniCart.Count == 0)
                                {
                                    <div class="mini-cart-empty">Giỏ hàng đang trống.<br /><small>Hãy chọn sản phẩm bạn yêu thích.</small></div>
                                }
                                else
                                {
                                    <div class="mini-cart-items">
                                        @foreach (var item in miniCart)
                                        {
                                            <div class="mini-cart-item" data-product-id="@item.ProductId">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" />
                                                <div class="mini-cart-info">
                                                    <div class="mini-cart-name">@item.ProductName</div>
                                                    <div class="mini-cart-price">
                                                        Giá: <span class="mini-cart-item-price">@item.Price.ToString("N0")</span> đ
                                                    </div>
                                                </div>

                                                <div class="mini-cart-controls">
                                                    <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="mini-cart-update-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <button type="button" class="btn mini-cart-dec" title="Giảm">−</button>
                                                        <input type="number" name="quantity" value="@item.Quantity" min="1" step="1"
                                                               class="mini-cart-quantity-input mini-cart-qty-display" />
                                                        <button type="button" class="btn mini-cart-inc" title="Tăng">+</button>
                                                    </form>
                                                    <form asp-controller="Cart" asp-action="Remove" method="post" class="mini-cart-remove-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <button type="button" class="mini-cart-remove">Xóa</button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="mini-cart-total"><span>Tạm tính</span><strong class="mini-cart-total-amount">@miniCart.Sum(i => i.TotalPrice).ToString("N0") đ</strong></div>
                                <div class="mini-cart-actions"><a asp-controller="Cart" asp-action="Index" class="btn btn-outline-success">Xem giỏ hàng</a><a asp-controller="Checkout" asp-action="Index" class="btn btn-success">Thanh toán</a></div>
                            </div>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    👤 @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">⚙️ Khu quản trị</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">🧾 Đơn hàng của tôi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Track">🔎 Tra cứu đơn hàng</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown account-menu"><a class="nav-link account-menu-trigger dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">👤 Tài khoản</a><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Đăng nhập</a></li><li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Đăng ký tài khoản</a></li></ul></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>CH&amp;T GOLF</h5>
                    <p>Trang bị golf chọn lọc cho trải nghiệm tự tin trên mọi sân cỏ.</p>
                    <div class="footer-social">
                        @* Đổi href bên dưới thành link shop thật của bạn *@
                        <a class="footer-social-btn" href="#" target="_blank" rel="noopener" title="TikTok">TikTok</a>
                        <a class="footer-social-btn" href="#" target="_blank" rel="noopener" title="Facebook">Facebook</a>
                        <a class="footer-social-btn" href="#" target="_blank" rel="noopener" title="Shopee">Shopee</a>
                        <a class="footer-social-btn" href="#" target="_blank" rel="noopener" title="Lazada">Lazada</a>
                        <a class="footer-social-btn" href="https://zalo.me/0900000000" target="_blank" rel="noopener" title="Zalo">Zalo</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <h6>Liên hệ</h6>
                    <p>Hotline: <a href="tel:0900000000">0900 000 000</a><br />Email: support@golfking.vn<br />Zalo: <a href="https://zalo.me/0900000000" target="_blank" rel="noopener">0900 000 000</a></p>
                </div>
                <div class="col-md-4">
                    <h6>Địa chỉ</h6>
                    <p>123 Đường Golf, Phường An Phú<br />TP. Thủ Đức, TP. Hồ Chí Minh<br />Thời gian: 08:30 – 21:30 hằng ngày</p>
                </div>
            </div>
            <div class="footer-bottom">© 2026 CH&amp;T GOLF. <a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></div>
        </div>
    </footer>
    <div class="contact-float" id="contactFloat" aria-label="Liên hệ nhanh">
        <div class="contact-float-actions" id="contactFloatActions" hidden>
            <div class="contact-phone-panel">
                <span class="contact-phone-label">Hotline</span>
                <strong class="contact-phone-number" id="contactPhoneDisplay">0900 000 000</strong>
                <button type="button" class="contact-phone-copy" id="copyPhoneBtn" data-phone="0900000000" title="Sao chép số">Copy</button>
            </div>
            <a class="contact-float-button contact-zalo" href="https://zalo.me/0900000000" target="_blank" rel="noopener" title="Chat Zalo" aria-label="Zalo">ZALO</a>
            <button type="button" class="contact-float-button contact-chat-btn" id="liveChatToggle" title="Chat với shop">CHAT</button>
        </div>

        <div class="live-chat-panel contact-chat-panel" id="liveChatPanel" hidden>
            <div class="live-chat-head">
                <strong>Chat CH&amp;T GOLF</strong>
                <button type="button" class="btn-close btn-close-white btn-sm" id="liveChatClose" aria-label="Đóng"></button>
            </div>
            <div class="live-chat-messages" id="liveChatMessages"></div>
            <form class="live-chat-form" id="liveChatForm">
                <div class="row g-1 mb-1">
                    <div class="col-7">
                        <input type="text" id="liveChatName" class="form-control form-control-sm"
                               placeholder="Tên của bạn"
                               value="@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "")"
                               maxlength="50" />
                    </div>
                    <div class="col-5">
                        <select id="liveChatGender" class="form-select form-select-sm">
                            <option value="">Giới tính</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex gap-1">
                    <input type="text" id="liveChatInput" class="form-control form-control-sm" placeholder="Nhập tin nhắn..." maxlength="1000" required autocomplete="off" />
                    <button type="submit" class="btn btn-sm btn-success">Gửi</button>
                </div>
            </form>
        </div>

        <button type="button" class="contact-float-toggle" id="contactFloatToggle" aria-expanded="false" aria-controls="contactFloatActions" title="Liên hệ">💬</button>
        <span class="contact-float-toast" id="contactFloatToast" hidden>Đã sao chép SĐT</span>
    </div>

    <!-- Cookie consent banner -->
    <div id="cookieBanner" class="cookie-banner d-none" aria-hidden="true">
        <div class="cookie-banner-inner">
            <div class="cookie-banner-icon" aria-hidden="true">🍪</div>
            <div class="cookie-text">
                <strong>Cookie</strong>
                <p>Chúng tôi dùng cookie để cá nhân hoá nội dung và cải thiện trải nghiệm trên website.</p>
            </div>
            <div class="cookie-banner-actions">
                <button type="button" id="acceptCookies" class="btn btn-sm cookie-accept">Đồng ý</button>
                <button type="button" id="dismissCookieBanner" class="btn btn-sm cookie-dismiss">Để sau</button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
