@model List<WebBanHang.Controllers.BlogPost>

@{
    ViewData["Title"] = "Blog Golf";
}

<div class="container my-4">
    <section class="catalogue-heading mb-4">
        <span>CH&amp;T GOLF JOURNAL</span>
        <h1>Blog Golf</h1>
        <p>Kiến thức, mẹo chơi và hướng dẫn chọn trang bị golf cho mọi trình độ.</p>
    </section>

    <p class="text-muted mb-4">Có <strong>@Model.Count</strong> bài viết</p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Chưa có bài viết nào.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-4 product-grid">
            @foreach (var post in Model)
            {
                <div class="col">
                    <div class="card product-card h-100 blog-card">
                        <a asp-action="Details" asp-route-id="@post.Id" class="product-image-link">
                            <img src="@post.ImageUrl" class="card-img-top" alt="@post.Title" />
                        </a>
                        <div class="card-body d-flex flex-column">
                            <p class="card-text text-muted small mb-1">@post.PublishedAt.ToString("dd/MM/yyyy") · @post.Author</p>
                            <h5 class="card-title">
                                <a asp-action="Details" asp-route-id="@post.Id" class="product-name-link">@post.Title</a>
                            </h5>
                            <p class="card-text text-muted small flex-grow-1">@post.Summary</p>
                            <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-outline-primary mt-auto">Đọc bài viết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
