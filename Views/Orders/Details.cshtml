@model Order

@{
    ViewData["Title"] = $"Đơn hàng {Model.OrderCode}";
    var payment = Model.Payments.FirstOrDefault();
    var steps = new[] { OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Shipping, OrderStatus.Completed };
    var currentStep = Array.IndexOf(steps, Model.Status);
    var isCancelled = Model.Status == OrderStatus.Cancelled;
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Đơn hàng @Model.OrderCode</h2>
            <p class="text-muted mb-0">Đặt lúc @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <span class="badge fs-6 @Model.Status.ToBadgeClass()">@Model.Status.ToVietnamese()</span>
    </div>

    <!-- Tiến trình xử lý đơn -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @if (isCancelled)
            {
                <div class="alert alert-secondary mb-0" role="alert">
                    Đơn hàng này đã được huỷ. Nếu bạn đã thanh toán, cửa hàng sẽ hoàn tiền theo thoả thuận.
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between">
                    @for (var i = 0; i < steps.Length; i++)
                    {
                        var done = i <= currentStep;
                        <div class="text-center flex-fill">
                            <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center @(done ? "bg-success text-white" : "bg-light text-muted border")"
                                 style="width: 40px; height: 40px;">@(i + 1)</div>
                            <div class="small mt-2 @(done ? "fw-bold" : "text-muted")">@steps[i].ToVietnamese()</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Sản phẩm</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(detail.Product?.ImageUrl ?? "/images/product-placeholder.svg")" alt=""
                                                 class="rounded border" style="width:52px;height:52px;object-fit:contain;background:#f5f5f5" />
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@detail.ProductId">
                                                @(detail.Product?.Name ?? "Sản phẩm")
                                            </a>
                                        </div>
                                    </td>
                                    <td class="text-end">@detail.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-center">@detail.Quantity</td>
                                    <td class="text-end">@detail.LineTotal.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Tổng cộng</th>
                                <th class="text-end text-danger">@Model.TotalAmount.ToString("N0") đ</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm mb-3">
                <div class="card-header fw-bold">Thông tin giao hàng</div>
                <div class="card-body">
                    <p class="mb-1"><strong>@Model.User?.FullName</strong></p>
                    <p class="mb-1">📞 @Model.User?.PhoneNumber</p>
                    <p class="mb-1">✉️ @Model.User?.Email</p>
                    <p class="mb-2">📍 @Model.ShippingAddress</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <p class="mb-2 text-muted">Ghi chú: @Model.Note</p>
                    }

                    @if (Model.Status is OrderStatus.Pending or OrderStatus.Confirmed)
                    {
                        <hr />
                        <p class="small text-muted mb-2">Đơn chưa giao — bạn có thể sửa thông tin bên dưới.</p>
                        <form asp-action="UpdateShippingInfo" asp-route-id="@Model.Id" method="post" class="vstack gap-2">
                            @Html.AntiForgeryToken()
                            <div>
                                <label class="form-label small fw-bold mb-1">Họ tên</label>
                                <input name="fullName" class="form-control form-control-sm" value="@Model.User?.FullName" required maxlength="100" />
                            </div>
                            <div>
                                <label class="form-label small fw-bold mb-1">Số điện thoại</label>
                                <input name="phoneNumber" class="form-control form-control-sm" value="@Model.User?.PhoneNumber" required />
                            </div>
                            <div>
                                <label class="form-label small fw-bold mb-1">Địa chỉ giao hàng</label>
                                <textarea name="shippingAddress" class="form-control form-control-sm" rows="2" required>@Model.ShippingAddress</textarea>
                            </div>
                            <div>
                                <label class="form-label small fw-bold mb-1">Ghi chú (không bắt buộc)</label>
                                <input name="note" class="form-control form-control-sm" value="@Model.Note" />
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary">Lưu thay đổi</button>
                        </form>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header fw-bold">Thanh toán</div>
                <div class="card-body">
                    <p class="mb-1">
                        Phương thức: <strong>@(payment?.Method.ToVietnamese() ?? "Chưa xác định")</strong>
                    </p>
                    <p class="mb-1">
                        Trạng thái: <strong>@(payment?.Status.ToVietnamese() ?? "—")</strong>
                    </p>
                    @if (payment?.PaidAt != null)
                    {
                        <p class="mb-1 text-muted">Đã thanh toán lúc @payment.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                    }
                    @if (payment != null && payment.Method == PaymentMethod.BankTransfer && payment.Status == PaymentStatus.Unpaid)
                    {
                        <a asp-controller="Checkout" asp-action="BankTransfer" asp-route-id="@Model.Id" class="btn btn-warning w-100 mt-2">
                            🏦 Xem mã QR để chuyển khoản
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">← Tiếp tục mua sắm</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Index" class="btn btn-outline-primary">Xem tất cả đơn hàng</a>
        }
        @if (Model.Status is OrderStatus.Pending or OrderStatus.Confirmed)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Huỷ đơn hàng này?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">Huỷ đơn hàng</button>
            </form>
        }
        @if (isCancelled)
        {
            <form asp-action="Reorder" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Đặt lại đơn hàng</button>
            </form>
        }
    </div>
</div>
