@model List<Order>

@{
    ViewData["Title"] = "Kết quả tra cứu đơn";
}

<div class="container my-4">
    <h2 class="fw-bold mb-3">Kết quả tra cứu</h2>
    <p class="text-muted">Tìm thấy <strong>@Model.Count</strong> đơn hàng.</p>

    <div class="row g-3">
        @foreach (var order in Model)
        {
            <div class="col-12">
                <div class="card order-card shadow-sm border-0">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <div class="fw-bold">@order.OrderCode</div>
                            <div class="text-muted small">@order.OrderDate.ToString("dd/MM/yyyy HH:mm") · @order.TotalAmount.ToString("N0") đ</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @order.Status.ToBadgeClass()">@order.Status.ToVietnamese()</span>
                            <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@order.Id">Xem</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <a asp-action="Track" class="btn btn-outline-secondary mt-3">← Tra cứu lại</a>
</div>
