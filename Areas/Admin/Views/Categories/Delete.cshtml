@model Category

@{
    ViewData["Title"] = "Xoá danh mục";
    var productCount = Model.Products.Count;
}

<h2 class="fw-bold mb-3 text-danger">🗑️ Xoá danh mục</h2>

@if (productCount > 0)
{
    <div class="alert alert-warning" role="alert">
        Danh mục này còn <strong>@productCount sản phẩm</strong> nên không thể xoá.
        Hãy chuyển các sản phẩm sang danh mục khác trước.
    </div>
}

<div class="card shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <h5 class="mb-1">@Model.Name</h5>
        <p class="text-muted">@Model.Description</p>
        <p>Số sản phẩm: <strong>@productCount</strong></p>
        <p>Bạn có chắc muốn xoá danh mục này không?</p>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Xoá</button>
            <a asp-action="Index" class="btn btn-outline-secondary">← Huỷ</a>
        </form>
    </div>
</div>
