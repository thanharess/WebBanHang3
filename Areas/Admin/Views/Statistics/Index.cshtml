@model StatisticsViewModel
@{
	ViewData["Title"] = "Thống kê";
	string J(object value) => System.Text.Json.JsonSerializer.Serialize(value);
	var monthClass = Model.MonthChangePercent >= 0 ? "text-success" : "text-danger";
	var monthIcon = Model.MonthChangePercent >= 0 ? "↑" : "↓";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
	<h2 class="fw-bold mb-0">📈 Thống kê bán hàng</h2>
	<div class="d-flex align-items-center gap-2 statistics-period-tools">
		<form method="get" class="d-flex gap-2">
			<select name="year" class="form-select statistics-period-select" onchange="this.form.submit()">
				@foreach (var item in Model.AvailableYears) { <option value="@item" selected="@(item == Model.SelectedYear)">@item</option> }
			</select>
			<select name="month" class="form-select statistics-period-select" onchange="this.form.submit()">
				@foreach (var item in Model.AvailableMonths) { <option value="@item" selected="@(item == Model.SelectedMonth)">Tháng @item</option> }
			</select>
		</form>
		<a class="btn btn-success text-nowrap" asp-action="ExportExcel" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth">⬇ Excel tháng</a>
	</div>
</div>

<div class="row g-3 mb-4">
	<div class="col-sm-6 col-xl-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Tổng doanh thu</div><div class="fs-4 fw-bold text-danger">@Model.TotalRevenue.ToString("N0") đ</div><div class="text-muted small">Không tính @Model.CancelledOrders đơn đã huỷ</div></div></div></div>
	<div class="col-sm-6 col-xl-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Doanh thu tháng @Model.SelectedMonth/@Model.SelectedYear</div><div class="fs-4 fw-bold">@Model.SelectedMonthRevenue.ToString("N0") đ</div><div class="small @monthClass">@monthIcon @Math.Abs(Model.MonthChangePercent).ToString("N1")% so với tháng trước</div></div></div></div>
	<div class="col-sm-6 col-xl-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Giá trị đơn trung bình</div><div class="fs-4 fw-bold">@Model.AverageOrderValue.ToString("N0") đ</div><div class="text-muted small">@Model.TotalOrders đơn hàng</div></div></div></div>
	<div class="col-sm-6 col-xl-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Khách hàng</div><div class="fs-4 fw-bold">@Model.CustomerCount</div><div class="text-muted small">Tháng đang xem: @Model.SelectedMonth/@Model.SelectedYear</div></div></div></div>
</div>

<div class="row g-3 mb-3">
	<div class="col-lg-8"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Doanh thu theo tháng năm @Model.SelectedYear</div><div class="card-body"><canvas id="monthlyChart" height="125"></canvas><div class="small text-muted mt-2">Tháng trước: @Model.PreviousMonthRevenue.ToString("N0") đ · Tháng đang chọn: @Model.SelectedMonthRevenue.ToString("N0") đ</div></div></div></div>
	<div class="col-lg-4"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Tỉ lệ đơn theo trạng thái</div><div class="card-body"><canvas id="statusChart" height="220"></canvas></div></div></div>
</div>

<div class="row g-3 mb-3">
	<div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Doanh thu theo năm</div><div class="card-body"><canvas id="yearlyChart" height="150"></canvas></div></div></div>
	<div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-bold">So sánh doanh thu theo năm</div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Năm</th><th class="text-end">Doanh thu</th><th class="text-center">Đơn</th><th class="text-end">So năm trước</th></tr></thead><tbody>@foreach (var item in Model.YearComparisons) { var changeClass = item.ChangePercent >= 0 ? "text-success" : "text-danger"; var icon = item.ChangePercent >= 0 ? "↑" : "↓"; <tr><td class="fw-bold">@item.Year</td><td class="text-end">@item.Revenue.ToString("N0") đ</td><td class="text-center">@item.Orders</td><td class="text-end @changeClass">@icon @Math.Abs(item.ChangePercent).ToString("N1")%</td></tr> }</tbody></table></div></div></div>
</div>

<div class="row g-3"><div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-bold">Top @Model.TopProductNames.Count sản phẩm bán chạy</div><div class="card-body">@if (Model.TopProductNames.Count == 0) { <p class="text-muted mb-0">Chưa có dữ liệu bán hàng.</p> } else { <canvas id="topProductChart" height="220"></canvas> }</div></div></div></div>

@section Scripts {
	<script src="~/lib/chartjs/chart.umd.min.js"></script>
	<script>
		const vnd = value => new Intl.NumberFormat('vi-VN').format(value) + ' đ';
		new Chart(document.getElementById('monthlyChart'), { type: 'bar', data: { labels: @Html.Raw(J(Model.MonthlyLabels)), datasets: [{ label: 'Doanh thu', data: @Html.Raw(J(Model.MonthlyRevenue)), backgroundColor: '#0b6b4d', borderRadius: 4 }] }, options: { responsive: true, plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => vnd(ctx.parsed.y) } } }, scales: { y: { beginAtZero: true, ticks: { callback: v => vnd(v) } } } } });
		new Chart(document.getElementById('yearlyChart'), { type: 'bar', data: { labels: @Html.Raw(J(Model.YearLabels)), datasets: [{ label: 'Doanh thu', data: @Html.Raw(J(Model.YearlyRevenue)), backgroundColor: '#c49a38', borderRadius: 4 }] }, options: { responsive: true, plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => vnd(ctx.parsed.y) } } }, scales: { y: { beginAtZero: true, ticks: { callback: v => vnd(v) } } } } });
		new Chart(document.getElementById('statusChart'), { type: 'doughnut', data: { labels: @Html.Raw(J(Model.StatusLabels)), datasets: [{ data: @Html.Raw(J(Model.StatusCounts)), backgroundColor: ['#ffc107', '#0dcaf0', '#0d6efd', '#198754', '#dc3545'] }] }, options: { responsive: true, plugins: { legend: { position: 'bottom' } } } });
		const topCanvas = document.getElementById('topProductChart');
		if (topCanvas) new Chart(topCanvas, { type: 'bar', data: { labels: @Html.Raw(J(Model.TopProductNames)), datasets: [{ label: 'Số lượng', data: @Html.Raw(J(Model.TopProductQuantities)), backgroundColor: '#ffc107', borderRadius: 4 }] }, options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true } } } });
	</script>
}