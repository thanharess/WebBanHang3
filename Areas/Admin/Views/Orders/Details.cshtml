@model Order

@{
    ViewData["Title"] = $"Đơn {Model.OrderCode}";
    var allowedNext = ViewData["AllowedNextStatuses"] as OrderStatus[] ?? Array.Empty<OrderStatus>();
    var payment = Model.Payments.FirstOrDefault();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Đơn hàng</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.OrderCode</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h2 class="fw-bold mb-1">Đơn @Model.OrderCode</h2>
        <p class="text-muted mb-0">Đặt lúc @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge fs-6 @Model.Status.ToBadgeClass()">@Model.Status.ToVietnamese()</span>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-bold">Sản phẩm trong đơn</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(detail.Product?.ImageUrl ?? "/images/product-placeholder.svg")" alt=""
                                             class="rounded border" style="width:48px;height:48px;object-fit:contain;background:#f5f5f5" />
                                        <span>@(detail.Product?.Name ?? "(sản phẩm đã xoá)")</span>
                                    </div>
                                </td>
                                <td class="text-end">@detail.UnitPrice.ToString("N0") đ</td>
                                <td class="text-center">@detail.Quantity</td>
                                <td class="text-end">@detail.LineTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Tổng cộng</th>
                            <th class="text-end text-danger">@Model.TotalAmount.ToString("N0") đ</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header fw-bold">Thanh toán</div>
            @if (Model.Payments.Count == 0)
            {
                <div class="card-body text-muted">Chưa có bản ghi thanh toán.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Phương thức</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Số tiền</th>
                                <th>Mã giao dịch</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Payments)
                            {
                                <tr>
                                    <td>@item.Method.ToVietnamese()</td>
                                    <td>@item.Status.ToVietnamese()</td>
                                    <td class="text-end">@item.Amount.ToString("N0") đ</td>
                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(item.TransactionCode) ? "—" : item.TransactionCode)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (payment != null && payment.Status != PaymentStatus.Paid && Model.Status != OrderStatus.Cancelled)
            {
                <div class="card-body border-top">
                    <form asp-action="ConfirmPayment" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Xác nhận đã nhận được tiền cho đơn này?');">
                        <button type="submit" class="btn btn-success w-100">💰 Xác nhận đã thu tiền</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-bold">Khách hàng &amp; giao hàng</div>
            <div class="card-body">
                <p class="mb-1"><strong>
                    @if (Model.User != null)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.User.Id">@Model.User.FullName</a>
                    }
                    else { <text>—</text> }
                </strong></p>
                <p class="mb-1">📞 @Model.User?.PhoneNumber</p>
                <p class="mb-1">✉️ @Model.User?.Email</p>
                <p class="mb-2">📍 @Model.ShippingAddress</p>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <p class="mb-2 text-muted">Ghi chú: @Model.Note</p>
                }

                @if (Model.Status is not OrderStatus.Completed and not OrderStatus.Cancelled)
                {
                    <hr />
                    <form asp-action="UpdateShipping" asp-route-id="@Model.Id" method="post" class="vstack gap-2">
                        <div>
                            <label class="form-label small fw-bold mb-1">Sửa địa chỉ giao hàng</label>
                            <textarea name="shippingAddress" class="form-control form-control-sm" rows="2" required>@Model.ShippingAddress</textarea>
                        </div>
                        <div>
                            <label class="form-label small fw-bold mb-1">Ghi chú</label>
                            <input name="note" class="form-control form-control-sm" value="@Model.Note" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Lưu thay đổi giao hàng</button>
                    </form>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header fw-bold">Cập nhật trạng thái</div>
            <div class="card-body">
                @if (allowedNext.Length == 0)
                {
                    <p class="text-muted mb-0">
                        Đơn đang ở trạng thái "<strong>@Model.Status.ToVietnamese()</strong>" nên không thể chuyển tiếp.
                    </p>
                }
                else
                {
                    <p class="text-muted small">
                        Luồng xử lý: Chờ xác nhận → Đã xác nhận → Đang giao hàng → Hoàn thành.
                        Huỷ đơn sẽ <strong>hoàn lại tồn kho</strong> và ghi nhận hoàn tiền cho đơn đã thu.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var next in allowedNext)
                        {
                            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Chuyển đơn sang &quot;@next.ToVietnamese()&quot;?');">
                                <input type="hidden" name="status" value="@next" />
                                <button type="submit" class="btn @(next == OrderStatus.Cancelled ? "btn-outline-danger" : "btn-primary")">
                                    @next.ToVietnamese()
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← Danh sách đơn hàng</a>
    <a asp-area="Admin" asp-controller="Email" asp-action="Index" asp-route-orderId="@Model.Id" class="btn btn-outline-primary">✉️ Gửi email đơn này</a>
    @if (Model.User != null)
    {
        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.User.Id" class="btn btn-outline-secondary">👤 Xem khách hàng</a>
    }
</div>
