@model DashboardViewModel

@{
    ViewData["Title"] = "Tổng quan";
}

<p class="text-muted mb-4">Xin chào, đây là bảng điều khiển CH&amp;T GOLF.</p>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat">
            <div class="label">Sản phẩm</div>
            <div class="value">@Model.ProductCount</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat gold">
            <div class="label">Danh mục</div>
            <div class="value">@Model.CategoryCount</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="text-decoration-none" asp-controller="Orders" asp-action="Index">
            <div class="admin-stat blue">
                <div class="label">Đơn hàng</div>
                <div class="value">@Model.OrderCount</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat orange">
            <div class="label">Khách hàng</div>
            <div class="value">@Model.CustomerCount</div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="text-muted small fw-bold text-uppercase" style="letter-spacing:.04em">Doanh thu (trừ đơn huỷ)</div>
            <div class="fs-2 fw-bold" style="color:#0b6b4d">@Model.TotalRevenue.ToString("N0") đ</div>
        </div>
        <a class="btn btn-primary" asp-controller="Statistics" asp-action="Index">Xem thống kê →</a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>5 đơn hàng mới nhất</span>
        <a class="small" asp-controller="Orders" asp-action="Index">Tất cả đơn</a>
    </div>
    @if (Model.LatestOrders.Count == 0)
    {
        <div class="card-body text-muted">Chưa có đơn hàng nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.LatestOrders)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">@order.OrderCode</a>
                            </td>
                            <td>@order.User?.FullName</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") đ</td>
                            <td><span class="badge @order.Status.ToBadgeClass()">@order.Status.ToVietnamese()</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
