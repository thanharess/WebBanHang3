{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"

    },
    // Tắt provider ghi log vào Windows Event Log. Provider này ném lỗi
    // "Cannot open log for source '.NET Runtime'. You may not have write access."
    // khi ứng dụng chạy bằng tài khoản không phải Administrator, và lỗi đó
    // làm sập luôn kết nối HTTP. Bật lại nếu bạn chạy bằng quyền Administrator.
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }

    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=WebBanHangDb;Trusted_Connection=True;MultipleActiveResultSets=true"

  },

  // Tài khoản ngân hàng để sinh mã VietQR cho khách chuyển khoản.
