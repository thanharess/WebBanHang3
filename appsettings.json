  // MB 970422, ACB 970416, VietinBank 970415, BIDV 970418, ...).
  // HÃY THAY bằng tài khoản thật của bạn trước khi dùng.
  "BankTransfer": {
    "BankName": "Vietcombank",
    "BankBin": "970436",
    "AccountNumber": "0123456789",
    "AccountName": "NGUYEN VAN A",
    "Template": "compact2"
  },

